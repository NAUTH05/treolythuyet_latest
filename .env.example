# Runtime configuration (copy to .env; never commit the real file)
NODE_ENV=production
PORT=3000
ADMIN_PASSWORD=replace-with-a-long-random-password

# Absolute path to the Firebase service-account JSON, kept outside the repository.
FIREBASE_SERVICE_ACCOUNT_FILE=/etc/treolythuyet/firebase-service-account.json
# GOOGLE_APPLICATION_CREDENTIALS may be used instead.

# Set to true only when the host provides Application Default Credentials.
FIREBASE_USE_APPLICATION_DEFAULT=false
